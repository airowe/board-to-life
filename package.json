{
  "name": "board-to-life",
  "version": "1.0.0",
  "description": "Photograph a whiteboard drawing, approve the scene, and let the class predict before real physics plays it out.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test",
    "drawings": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-drawings.mjs",
    "drawings:draw": "node scripts/draw-checks.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "matter-js": "^0.20.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true
}
