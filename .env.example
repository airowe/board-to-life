# Copy to .env.local and fill in. .env.local is ignored by git.
# Meta Model API key (https://dev.meta.ai)
MODEL_API_KEY=
# Baseten API key (https://www.baseten.co)
BASETEN_API_KEY=
# Which reader the dev server uses for /api/understand: stub (default), meta or baseten.
SCENE_READER=stub
# Optional reasoning effort for the scene reader: minimal, low, medium or high.
READER_EFFORT=
